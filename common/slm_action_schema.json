{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "empty": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "datasetName": {
      "enum": ["mnist", "cifar10", "fashion_mnist", "femnist"]
    },
    "agentInitialModelParameters": {
      "type": "object",
      "properties": {
        "model_name": {"$ref": "#/$defs/datasetName"}
      },
      "required": ["model_name"],
      "additionalProperties": false
    },
    "preprocessableDatasetName": {
      "enum": ["mnist", "cifar10", "fashion_mnist", "femnist"]
    },
    "cnnArchitecture": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "b1_c8_k3",
            "b1_c8_k5",
            "b1_c16_k3",
            "b1_c16_k5",
            "b2_c8_k3",
            "b2_c8_k5",
            "b2_c16_k3",
            "b2_c16_k5"
          ]
        },
        "blocks": {"enum": [1, 2]},
        "channels": {"enum": [8, 16]},
        "kernel_size": {"enum": [3, 5]}
      },
      "required": ["id", "blocks", "channels", "kernel_size"],
      "additionalProperties": false
    },
    "modelTraining": {
      "type": "object",
      "properties": {
        "optimizer": {"enum": ["adam", "adamw", "sgd", "rmsprop"]},
        "learning_rate": {"type": "number", "minimum": 0.000001, "maximum": 0.1},
        "batch_size": {"type": "integer", "minimum": 8, "maximum": 256},
        "augmentation": {"enum": ["none", "flip_shift"]}
      },
      "additionalProperties": false
    },
    "modelLayer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {"enum": ["conv2d", "separable_conv2d"]},
            "filters": {"type": "integer", "minimum": 1, "maximum": 1024},
            "kernel_size": {"type": "integer", "minimum": 1, "maximum": 15},
            "strides": {"type": "integer", "minimum": 1, "maximum": 8},
            "padding": {"enum": ["same", "valid"]},
            "activation": {"enum": ["relu", "gelu", "silu", "tanh", "sigmoid", "linear", "softmax", "elu", "leaky_relu"]}
          },
          "required": ["type", "filters", "kernel_size"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"enum": ["max_pooling2d", "average_pooling2d"]},
            "pool_size": {"type": "integer", "minimum": 2, "maximum": 8}
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"enum": ["batch_normalization", "flatten", "global_average_pooling2d", "global_average_pooling1d"]}
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "dropout"},
            "rate": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "dense"},
            "units": {"type": "integer", "minimum": 1, "maximum": 8192},
            "activation": {"enum": ["relu", "gelu", "silu", "tanh", "sigmoid", "linear", "softmax", "elu", "leaky_relu"]}
          },
          "required": ["type", "units"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "patch_embedding"},
            "patch_size": {"type": "integer", "minimum": 1, "maximum": 14},
            "embed_dim": {"type": "integer", "minimum": 8, "maximum": 1024}
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "transformer_encoder"},
            "embed_dim": {"type": "integer", "minimum": 8, "maximum": 1024},
            "num_heads": {"type": "integer", "minimum": 1, "maximum": 32},
            "ff_dim": {"type": "integer", "minimum": 8, "maximum": 4096},
            "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
            "activation": {"enum": ["relu", "gelu", "silu", "tanh", "sigmoid", "linear", "softmax", "elu", "leaky_relu"]}
          },
          "required": ["type", "num_heads", "ff_dim"],
          "additionalProperties": false
        }
      ]
    },
    "customArchitecture": {
      "type": "object",
      "properties": {
        "model_type": {"const": "custom"},
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "blocks": {"type": "integer", "minimum": 1, "maximum": 32},
        "channels": {"type": "integer", "minimum": 1, "maximum": 1024},
        "channel_schedule": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "integer", "minimum": 1, "maximum": 1024}
        },
        "block_type": {"enum": ["conv2d", "separable_conv2d"]},
        "kernel_size": {"type": "integer", "minimum": 1, "maximum": 15},
        "head_units": {"type": "integer", "minimum": 0, "maximum": 8192},
        "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "attention": {"type": "boolean"},
        "convs_per_block": {"type": "integer", "minimum": 1, "maximum": 2},
        "layers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/modelLayer"}
        },
        "training": {"$ref": "#/$defs/modelTraining"},
        "dataset_name": {"$ref": "#/$defs/datasetName"},
        "input_shape": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 2048},
            {"type": "integer", "minimum": 1, "maximum": 2048},
            {"type": "integer", "enum": [1, 3]}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "classes": {"type": "array", "minItems": 2, "maxItems": 1000, "items": {"type": "string", "minLength": 1}},
        "num_classes": {"type": "integer", "minimum": 2, "maximum": 1000},
        "parameter_count": {"type": "integer", "minimum": 1, "maximum": 20000000},
        "initialization_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "normalization": {"type": "object"}
      },
      "required": ["model_type", "layers"],
      "additionalProperties": false
    },
    "pretrainedDeiT": {
      "type": "object",
      "properties": {
        "model_type": {"const": "pretrained_deit"},
        "model_id": {"const": "facebook/deit-tiny-patch16-224"},
        "training": {"$ref": "#/$defs/modelTraining"},
        "dataset_name": {"$ref": "#/$defs/datasetName"},
        "input_shape": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1, "maximum": 2048},
            {"type": "integer", "minimum": 1, "maximum": 2048},
            {"type": "integer", "enum": [1, 3]}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "classes": {"type": "array", "minItems": 2, "maxItems": 1000, "items": {"type": "string", "minLength": 1}},
        "num_classes": {"type": "integer", "minimum": 2, "maximum": 1000},
        "parameter_count": {"type": "integer", "minimum": 1, "maximum": 20000000},
        "initialization_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "normalization": {"type": "object"}
      },
      "required": ["model_type", "model_id"],
      "additionalProperties": false
    },
    "modelArchitecture": {
      "oneOf": [
        {"$ref": "#/$defs/cnnArchitecture"},
        {"$ref": "#/$defs/customArchitecture"},
        {"$ref": "#/$defs/pretrainedDeiT"}
      ]
    },
    "runIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "preprocess_dataset",
              "description": "Preprocess a supported dataset and distribute verified worker shards.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {
                "dataset_name": {"$ref": "#/$defs/preprocessableDatasetName"},
                "normalization": {"enum": ["standard", "minmax", "none"]},
                "target_size": {
                  "type": "object",
                  "properties": {
                    "height": {"type": "integer", "minimum": 1, "maximum": 2048},
                    "width": {"type": "integer", "minimum": 1, "maximum": 2048}
                  },
                  "required": ["height", "width"],
                  "additionalProperties": false
                },
                "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                "replace_existing": {"type": "boolean"},
                "dataset_split": {
                  "enum": ["stratified", "dirichlet_a01", "dirichlet_a03", "dirichlet_a05", "dirichlet_a07", "dirichlet_a09"]
                }
              },
              "required": ["dataset_name"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "create_initial_model",
              "description": "Build an initial model for a dataset and distribute it to the workers. Omit architecture or pass an empty object to use the standard small CNN default.",
              "x-agent-tool": true,
              "x-agent-parameters": {"$ref": "#/$defs/agentInitialModelParameters"}
            },
            "parameters": {
              "type": "object",
              "properties": {
                "model_name": {"$ref": "#/$defs/datasetName"},
                "architecture": {
                  "anyOf": [
                    {"$ref": "#/$defs/modelArchitecture"},
                    {"type": "object", "maxProperties": 0, "additionalProperties": false}
                  ]
                },
                "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                "replace_existing": {"type": "boolean"},
                "restore_baseline": {"type": "boolean"},
                "from_trained_model": {"type": "boolean", "description": "Install the newest run's best trained model, with its weights, on every worker (warm start)."},
                "source_worker": {"type": "string", "pattern": "^worker[1-9][0-9]*$"},
                "best_checkpoint": {"enum": ["save", "install"], "description": "Save the newest run's model of source_worker as the supervisor run's best checkpoint, or install that checkpoint on every worker."},
                "checkpoint_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}
              },
              "required": ["model_name"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "start_training",
              "description": "Start distributed training with the supplied dataset and run parameters. Omit architecture to use the currently installed model; do not pass an empty architecture object.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {
                "rounds": {"type": "integer", "minimum": 1, "maximum": 100},
                "epochs": {"type": "integer", "minimum": 1, "maximum": 50},
                "dataset_name": {"$ref": "#/$defs/datasetName"},
                "architecture": {"$ref": "#/$defs/modelArchitecture"},
                "dataset_split": {"enum": ["stratified", "dirichlet_a01", "dirichlet_a03", "dirichlet_a05", "dirichlet_a07", "dirichlet_a09"]},
                "aggregation": {"enum": ["fedavg", "uniform", "metropolis", "trimmed_mean"]},
                "sync_mode": {"enum": ["sync", "semi_sync", "async"]},
                "sync_deadline_seconds": {"type": "integer", "minimum": 5, "maximum": 7200},
                "seeds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
                },
                "augmentation": {"enum": ["none", "flip_shift"]},
                "senders": {
                  "type": "object",
                  "description": "Receiver -> workers it receives from; fixes the graph of the learned topology.",
                  "minProperties": 2,
                  "maxProperties": 64,
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 63,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1, "maxLength": 64}
                  }
                }
              },
              "required": ["rounds", "epochs", "dataset_name"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "stop_training",
              "description": "Stop the currently active training, topology optimization, or NAS run.",
              "x-agent-tool": true
            },
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_topology",
              "description": "Change the active worker communication topology.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {
                "topology": {
                  "enum": [
                    "ring",
                    "directed_ring",
                    "bidirectional_ring",
                    "mesh",
                    "chain",
                    "star",
                    "learned"
                  ]
                }
              },
              "required": ["topology"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "optimize_topology",
              "description": "Start a measured sweep that selects a worker topology, aggregation rule or synchronization mode.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {
                "rounds": {"type": "integer", "minimum": 1, "maximum": 100},
                "epochs": {"type": "integer", "minimum": 1, "maximum": 50},
                "seeds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
                },
                "alphas": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "number", "enum": [0.1, 0.3, 0.5, 0.7, 0.9]}
                },
                "dataset_name": {"type": "string", "enum": ["mnist", "cifar10", "fashion_mnist", "femnist"]},
                "augmentation": {"enum": ["none", "flip_shift"]},
                "dimension": {"enum": ["topology", "aggregation", "sync"]},
                "topology": {"enum": ["directed_ring", "bidirectional_ring", "mesh", "chain", "star"]},
                "aggregation": {"enum": ["fedavg", "uniform", "metropolis", "trimmed_mean"]},
                "sync_mode": {"enum": ["sync", "semi_sync", "async"]},
                "sync_deadline_seconds": {"type": "integer", "minimum": 5, "maximum": 7200}
              },
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_rounds",
              "description": "Set the distributed training round count.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {"rounds": {"type": "integer", "minimum": 1, "maximum": 100}},
              "required": ["rounds"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "set_epochs",
              "description": "Set the local training epoch count.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {"epochs": {"type": "integer", "minimum": 1, "maximum": 50}},
              "required": ["epochs"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "enable_nas",
              "description": "Start or configure neural architecture search on the worker dataset shards.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "dataset_name": {"$ref": "#/$defs/datasetName"},
                "rounds": {"type": "integer", "minimum": 1, "maximum": 100},
                "epochs": {"type": "integer", "minimum": 1, "maximum": 50},
                "seeds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
                },
                "search_time_limit_seconds": {
                  "type": "integer",
                  "minimum": 90,
                  "maximum": 600
                },
                "smoke_test": {"type": "boolean"},
                "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                "objective": {"enum": ["local", "federated"]},
                "search_space": {"enum": ["compact", "extended"]},
                "augmentation": {"enum": ["none", "flip_shift"]},
                "seed_architectures": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {"$ref": "#/$defs/modelArchitecture"}
                },
                "federated_rounds": {"type": "integer", "minimum": 1, "maximum": 20},
                "federated_epochs": {"type": "integer", "minimum": 1, "maximum": 5}
              },
              "required": ["enabled"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {"const": "run_hpo", "description": "Tune the learning rate and batch size of one custom architecture on every worker's own data split and select the best mean validation accuracy."},
            "parameters": {
              "type": "object",
              "properties": {
                "dataset_name": {"$ref": "#/$defs/datasetName"},
                "architecture": {"$ref": "#/$defs/customArchitecture"},
                "search_time_limit_seconds": {"type": "integer", "minimum": 90, "maximum": 600},
                "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
              },
              "required": ["dataset_name", "architecture"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {"const": "prune_model", "description": "Structurally prune the best trained worker model (remove the least important channels and units) and redistribute the smaller model with its trained weights to every worker."},
            "parameters": {
              "type": "object",
              "properties": {
                "model_name": {"$ref": "#/$defs/datasetName"},
                "ratio": {"type": "number", "minimum": 0.1, "maximum": 0.8},
                "restore_source": {"type": "boolean", "description": "Undo the last pruning: redistribute the unpruned source model with its trained weights."},
                "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
              },
              "required": ["model_name"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "get_status",
              "description": "Read the current master and distributed-training status.",
              "x-agent-tool": true
            },
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "get_logs",
              "description": "Read recent master service logs.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 100}},
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "get_results",
              "description": "Read saved and active experiment results, including progress and metrics.",
              "x-agent-tool": true
            },
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "compare_runs",
              "description": "Compare the supplied completed experiment run identifiers.",
              "x-agent-tool": true
            },
            "parameters": {
              "type": "object",
              "properties": {"run_ids": {"$ref": "#/$defs/runIds"}},
              "required": ["run_ids"],
              "additionalProperties": false
            }
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {"const": "clarify", "x-agent-tool": false},
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {"const": "refuse", "x-agent-tool": false},
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {"const": "redirect", "x-agent-tool": false},
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {"const": "suggest_next_action", "x-agent-tool": false},
            "parameters": {"$ref": "#/$defs/empty"}
          },
          "required": ["action", "parameters"],
          "additionalProperties": false
        }
      ]
    },
    "chatResponse": {
      "type": "object",
      "properties": {
        "reply": {"type": "string", "minLength": 1, "maxLength": 600},
        "action": {"$ref": "#/$defs/action"}
      },
      "required": ["reply", "action"],
      "additionalProperties": false
    }
  }
}
