# Copy to .env and fill in real values before runtime.
# This file intentionally uses placeholders only.

APP_ENV=development
LOG_LEVEL=INFO

# PC / DTN
DTN_HOST=0.0.0.0
DTN_BACKEND_PORT=8000
DTN_FRONTEND_PORT=5173
DTN_API_TOKEN=replace-with-random-secret-at-least-32-characters
DTN_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.11.12:5173
DTN_POLL_INTERVAL_SECONDS=3
DTN_DEVICE_TIMEOUT_SECONDS=2.5
DTN_HISTORY_RETENTION_COUNT=2000
DTN_AGENT_MAX_TOOL_CALLS=8
DTN_AGENT_HISTORY_MESSAGES=8
DTN_AGENT_ACTION_HISTORY_LIMIT=20

# Device inventory
PC_IP=192.168.11.12
MASTER_IP=192.168.11.15
WORKER1_IP=192.168.11.123
WORKER2_IP=192.168.11.14
WORKER3_IP=192.168.11.13
WORKER4_IP=192.168.11.75
WORKER5_IP=192.168.11.76
WORKER6_IP=192.168.11.97
WORKER7_IP=192.168.11.100
WORKER8_IP=192.168.11.99

MASTER_SSH_USER=hammad
WORKER1_SSH_USER=hammad
WORKER2_SSH_USER=hammad
WORKER3_SSH_USER=hammad
WORKER4_SSH_USER=jetson5
WORKER5_SSH_USER=hammad
WORKER6_SSH_USER=hammad
WORKER7_SSH_USER=hammad
WORKER8_SSH_USER=hammad

MASTER_API_TOKEN=replace-with-real-token
WORKER1_API_TOKEN=replace-with-real-token
WORKER2_API_TOKEN=replace-with-real-token
WORKER3_API_TOKEN=replace-with-real-token
WORKER4_API_TOKEN=replace-with-real-token
WORKER5_API_TOKEN=replace-with-real-token
WORKER6_API_TOKEN=replace-with-real-token
WORKER7_API_TOKEN=replace-with-real-token
WORKER8_API_TOKEN=replace-with-real-token

# Master service
MASTER_SERVICE_PORT=5002
MASTER_SLM_PORT=5003
MASTER_SLM_API_TOKEN=replace-with-a-random-master-slm-token
MASTER_OLLAMA_MODEL=qwen3.5:4b
MASTER_OLLAMA_HOST=http://localhost:11434

# Worker service
WORKER_SERVICE_PORT=5001
WORKER_TRAINING_PORT=5004
WORKER_LOCAL_EPOCHS=5
WORKER_ROUNDS=10

# Topology / training defaults
TOPOLOGY=ring
ROUND_COUNT=10
LOCAL_EPOCHS=5
ENABLE_NAS=false

# Dataset and storage
DATASET_PATH=/data/co2_indoor.csv
DATASET_NAME=co2_indoor
TRAINING_DB_PATH=./data/training.db

# Optional OpenAI / synthetic data generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security
JWT_SECRET=replace-with-a-long-random-secret
