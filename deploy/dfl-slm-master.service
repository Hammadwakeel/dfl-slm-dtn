[Unit]
Description=DFL-SLM authenticated Ollama assistant API
After=network-online.target ollama.service dfl-slm-status.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=hammad
Group=hammad
WorkingDirectory=/opt/dfl-slm-dtn
EnvironmentFile=/etc/dfl-slm-master.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Jetson CPU and GPU share RAM: grow GPU memory on demand instead of reserving it up front,
# and limit glibc malloc arenas so the threaded HTTP server does not fragment memory.
Environment=TF_FORCE_GPU_ALLOW_GROWTH=true
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/dfl-slm-dtn/master/venv/bin/waitress-serve --listen=0.0.0.0:5003 --threads=4 master.wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
ReadWritePaths=/var/log/dfl-slm-master /var/lib/dfl-slm-master

[Install]
WantedBy=multi-user.target
